COMPOSE_PROJECT_NAME=hellodata
COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yaml:base/base-services.yaml:default_data_domain/default-data-domain-services.yaml
# COMPOSE_FILE=docker-compose.yaml:base/base-services.yaml:default_data_domain/default-data-domain-services.yaml:default_data_domain/default-data-domain-jupyterhub.yaml:extra_data_domain/extra-data-domain-services.yaml
COMPOSE_FILE=docker-compose.yaml:base/base-services.yaml:default_data_domain/default-data-domain-services.yaml:extra_data_domain/extra-data-domain-services.yaml

REDIS_HOST=redis
REDIS_PORT=6379

# Database config
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Keycloak
KC_HOSTNAME=192.168.51.168

#common mail config
SPRING_MAIL_HOST=smtp4dev
SPRING_MAIL_PORT=25

SPRING_BOOT_ADMIN_CLIENT_URL=http://monitoring-sba:8080

NATS_SPRING_SERVER=nats://nats:4222

SPRING_DATA_REDIS_HOST=redis

#common oauth config
# KEYCLOAK_SERVER_METADATA_URL=http://keycloak.localhost:38080/realms/hellodata/.well-known/openid-configuration
# KEYCLOAK_API_BASE_URL=http://keycloak.localhost:38080/realms/hellodata/protocol/
# KEYCLOAK_BASE_URL=http://keycloak.localhost:38080/realms/hellodata

KEYCLOAK_SERVER_METADATA_URL=http://192.168.51.168:38080/realms/hellodata/.well-known/openid-configuration
KEYCLOAK_METADATA_URL=http://192.168.51.168:38080/realms/hellodata/.well-known/openid-configuration
KEYCLOAK_API_BASE_URL=http://192.168.51.168:38080/realms/hellodata/protocol/
KEYCLOAK_BASE_URL=http://192.168.51.168:38080/realms/hellodata

#portal keycloak config for spring boot apps
# HELLO_DATA_AUTH_SERVER_URL=http://keycloak.localhost:38080
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://keycloak.localhost:38080/realms/hellodata
# SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_KEYCLOAK_ISSUER_URI=http://keycloak.localhost:38080/realms/hellodata
HELLO_DATA_AUTH_SERVER_URL=http://192.168.51.168:38080
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://192.168.51.168:38080/realms/hellodata
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_KEYCLOAK_ISSUER_URI=http://192.168.51.168:38080/realms/hellodata

# API
HELLO_DATA_CORS_ALLOWED_ORIGINS=https://192.168.51.168:8080,http://192.168.51.168:38080,http://192.168.51.168:8080,http://localhost:8080,https://localhost:8080
HELLO_DATA_AUTH_SERVER_REDIRECT_URL=https://192.168.51.168:8080
SPRING_PROFILES_ACTIVE=disable-cors
HELLO_DATA_AUTH_SERVER_URL=http://192.168.51.168:38080
HELLO_DATA_AUTH_SERVER_REALM=hellodata
HELLO_DATA_AUTH_SERVER_CLIENT_ID=frontend-client

# DBT DOCS
DBT_DOCS_INSTANCE_URL=http://192.168.51.168:8086/dbt-docs/

## SFTPGO
SFTPGO_INSTANCE_URL=http://192.168.51.168:8090

## CloudBeaver
CLOUDBEAVER_INSTANCE_URL=http://192.168.51.168:8978/cloudbeaver/
# CLOUDBEAVER_UPSTREAM_URI=http://cloudbeaver:8978

#common DB config
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
HD_PLATFORM=linux/amd64 #linux/amd64 or linux/arm64

## AIRFLOW
#airflow common
# AIRFLOW_UID=50000
AIRFLOW_UID=1001
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW_WEBSERVER_HOST_PORT=28080
_PIP_ADDITIONAL_REQUIREMENTS=/opt/airflow/lib-dev/dlt_ingestion-0.1.1-py3-none-any.whl
KEYCLOAK_CLIENT_SECRET='not used'
KEYCLOAK_CLIENT_ID=frontend-client
AIRFLOW_INSTANCE_URL=http://192.168.51.168:28080/airflow
